FILE = "employees.txt"
def add():
    emp = input("Employee ID: ")
    name = input("Name: ")
    salary = input("Salary: ")

    with open(FILE, "a") as f:
        f.write(f"{emp}|{name}|{salary}\n")
    print("Employee added successfully.")
def display():
    try:
        with open(FILE) as f:
            print("\n--- EMPLOYEE DETAILS ---")
            for x in f:
                e = x.strip().split("|")
                print("ID:", e[0], "Name:", e[1], "Salary:", e[2])
    except FileNotFoundError:
        print("No employees found.")
def search():
    emp = input("Enter Employee ID: ")
    try:
        with open(FILE) as f:
            for x in f:
                e = x.strip().split("|")
                if e[0] == emp:
                    print("ID:", e[0], "Name:", e[1], "Salary:", e[2])
                    return
        print("Employee not found.")
    except FileNotFoundError:
        print("No employees found.")
while True:
    print("\n===== EMPLOYEE MANAGEMENT =====")
    print("1. Add Employee")
    print("2. Display Employees")
    print("3. Search Employee")
    print("4. Exit")
    ch = input("Enter choice: ")
    if ch == "1":
        add()
    elif ch == "2":
        display()
    elif ch == "3":
        search()
    elif ch == "4":
        print("Thank you!")
        break
    else:
        print("Invalid choice.")

